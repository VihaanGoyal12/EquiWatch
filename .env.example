# Database (Defaults to local SQLite for immediate frictionless start; PostgreSQL supported)
DATABASE_URL=sqlite:///./equiwatch.db

# JWT Security Key
SECRET_KEY=equiwatch-hackathon-secure-jwt-secret-key-2025
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Insight API (Optional: Fallback rule engine runs locally if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
